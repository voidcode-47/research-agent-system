# === LLM 提供商 ===
# 在「设置 → 模型服务与协议」中添加自定义服务和 API Key，并选择当前模型。
DEFAULT_LLM_PROVIDER=ollama

# 旧版自定义 OpenAI 兼容 API（已有配置会自动迁移；新安装请留空）
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_API_MODEL=

# === Ollama 本地模型 ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# === LM Studio 本地模型 ===
# 需先在 LM Studio 中加载模型并开启 Local Server (Developer 标签页)
LMSTUDIO_BASE_URL=http://localhost:1234
# 留空则自动使用 LM Studio 当前已加载的模型
LMSTUDIO_MODEL=

# === 论文工作台 ===
# 后台任务同时执行数（1-16）与排队/运行任务上限（1-100），修改后需重启
PAPER_TASK_WORKERS=3
PAPER_MAX_ACTIVE_TASKS=12
# 已结束任务在内存中保留的分钟数（0-525600；0 = 不按时间清理，仍受 100 条硬上限约束）
PAPER_TASK_RETENTION_MINUTES=1440
# 每日 LLM 调用配额（按 key 计数，论文任务默认 local；0 = 当日不可调用）
# 批量改写提交前会按所选段落数预检；预检不预留额度，运行中仍可能因额度不足提前停止
DAILY_QUOTA=30

# === 管理员账号 ===
# 管理员可修改模型配置，且不受每日配额限制；普通用户只能使用管理员设定的模型。
ADMIN_USERNAME=admin
# 留空则首次启动自动生成随机密码，保存在 data/admin_credentials.txt
ADMIN_PASSWORD=

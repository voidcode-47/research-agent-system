# === LLM 提供商 ===
# 重要：API Key 不预存在本文件中，请在设置页「模型提供商」中
# 填写各家云厂商的 Key（DeepSeek / 智谱 / 通义 / 自定义 API），保存后自动写入 .env。
DEFAULT_LLM_PROVIDER=deepseek

# DeepSeek（Key 在网页模型配置中填写）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 智谱 GLM（Key 在网页模型配置中填写）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 通义千问 DashScope（Key 在网页模型配置中填写）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 自定义 OpenAI 兼容 API（网页「自定义 API」中填写 Base URL / Key / 模型名后保存）
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_API_MODEL=

# === Ollama 本地模型 ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# === LM Studio 本地模型 ===
# 需先在 LM Studio 中加载模型并开启 Local Server (Developer 标签页)
LMSTUDIO_BASE_URL=http://localhost:1234
# 留空则自动使用 LM Studio 当前已加载的模型
LMSTUDIO_MODEL=

# === 论文工作台 ===
# 每日 LLM 调用配额（按 key 计数，论文任务默认 local）
DAILY_QUOTA=30

# === 管理员账号 ===
# 管理员可修改模型配置，且不受每日配额限制；普通用户只能使用管理员设定的模型。
ADMIN_USERNAME=admin
# 留空则首次启动自动生成随机密码，保存在 data/admin_credentials.txt
ADMIN_PASSWORD=

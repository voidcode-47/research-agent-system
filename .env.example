# === LLM 提供商（按需填写，留空则不可用）===
DEFAULT_LLM_PROVIDER=openai
DEFAULT_EMBEDDING_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 智谱 GLM
ZHIPU_API_KEY=

# 通义千问 (DashScope)
DASHSCOPE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# === 自定义 OpenAI 兼容 API ===
# 连接任意 OpenAI 兼容接口（各类中转 / 自建网关 / 其他厂商）。
# 也可不在此填写，直接在侧边栏选择「自定义 API」后填写并保存。
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_API_MODEL=

# === Ollama 本地模型 ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# === LM Studio 本地模型 ===
# 需先在 LM Studio 中加载模型并开启 Local Server (Developer 标签页)
LMSTUDIO_BASE_URL=http://localhost:1234
# 留空则自动使用 LM Studio 当前已加载的模型
LMSTUDIO_MODEL=
# 留空则自动从已加载模型中识别 embedding 模型（id 含 embed/bge/e5 等）
LMSTUDIO_EMBEDDING_MODEL=
# Ollama embedding 模型，留空用 nomic-embed-text
OLLAMA_EMBEDDING_MODEL=

# === RAG 参数 ===
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# === 安全参数 ===
MAX_REACT_ITERATIONS=10
MAX_TOKEN_BUDGET=8000

# === 存储 ===
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOADS_DIR=./data/uploads
CACHE_DIR=./data/cache
